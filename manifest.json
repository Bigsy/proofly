{
  "manifest_version": 3,
  "name": "Proofly",
  "version": "0.1.9",
  "description": "Proofly — private, offline proofreading powered by packaged Harper, with optional Chrome AI rewrites.",
  "homepage_url": "https://github.com/Bigsy/proofly",
  "minimum_chrome_version": "141",
  "permissions": [
    "sidePanel",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "Proofly",
    "default_popup": "popup/popup.html"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page/content/*",
        "page/content/adapters/*",
        "page/content/bridge/*",
        "lib/*",
        "ui/correction-card.js",
        "ui/icons.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
