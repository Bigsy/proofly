{
  "name": "proofly",
  "private": true,
  "license": "MIT",
  "version": "0.1.10",
  "description": "Proofly — private, on-device proofreading Chrome extension (no build step; this package holds the dev/test tooling).",
  "scripts": {
    "test": "vitest run",
    "test:browser": "playwright test test/browser",
    "test:watch": "vitest",
    "lint": "eslint .",
    "vendor:harper": "bash tools/vendor-harper.sh",
    "vendor:harper:check": "bash tools/vendor-harper.sh --check",
    "verify:harper": "node tools/verify-harper.mjs",
    "pack:store": "bash tools/package-store.sh"
  },
  "devDependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.0",
    "@codemirror/view": "6.43.4",
    "@eslint/js": "^10.0.1",
    "@lexical/history": "0.46.0",
    "@lexical/plain-text": "0.46.0",
    "@lexical/selection": "0.46.0",
    "@playwright/test": "^1.61.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "ckeditor4": "4.22.1",
    "ckeditor5": "48.2.0",
    "codemirror": "5.65.21",
    "draft-js": "0.11.7",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "harper.js": "2.7.0",
    "jsdom": "^26.1.0",
    "lexical": "0.46.0",
    "prosemirror-commands": "1.7.1",
    "prosemirror-history": "1.5.0",
    "prosemirror-model": "1.25.9",
    "prosemirror-schema-basic": "1.2.4",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.41.9",
    "quill": "2.0.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "slate": "0.124.1",
    "slate-history": "0.113.1",
    "tinymce": "8.2.2",
    "trix": "2.1.19",
    "vitest": "^3.2.4"
  }
}
